# FourthDown AI local development environment
# Copy to .env.local.
# Never commit .env.local or real secrets.

CFBD_API_KEY=replace_with_your_cfbd_api_key

# Local service ports
BACKEND_PORT=8080
ML_PORT=8000
FRONTEND_PORT=5173

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fourthdown
SPRING_DATASOURCE_USERNAME=fourthdown
SPRING_DATASOURCE_PASSWORD=fourthdown_dev

# Spring -> FastAPI
ML_BASE_URL=http://localhost:8000

# Frontend origin for Spring CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional Spring/JPA overrides
HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Optional FastAPI settings
HOST=0.0.0.0
RELOAD=false
